# ── Ambiente ──────────────────────────────────────────────────────────────────
# "homolog" para testes | "production" para produção
ENV=homolog

# ── Autenticação da API ────────────────────────────────────────────────────────
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
# Configurar também no AppBuilder como header X-API-Key
API_KEY=

# ── Credenciais Finnet ─────────────────────────────────────────────────────────
FINNET_USERNAME=
FINNET_PASSWORD=
FINNET_TOKEN_SECRET=   # confirmar com suporte da Finnet

# ── Dados bancários — Bradesco (banco 237) ─────────────────────────────────────
BANK_IDENTIFIER=237
BANK_BRANCH=1
BANK_BRANCH_IDENTIFIER=0
BANK_ACCOUNT=
BANK_ACCOUNT_IDENTIFIER=0
BANK_AGREEMENT=

# ── Dados da empresa pagadora ──────────────────────────────────────────────────
COMPANY_REGISTERED_NUMBER=
COMPANY_NAME=
COMPANY_TYPE=2
COMPANY_ADDRESS_ZIP_CODE=
COMPANY_ADDRESS=
COMPANY_ADDRESS_NUMBER=
COMPANY_ADDRESS_COMPLEMENT=
COMPANY_ADDRESS_NEIGHBORHOOD=
COMPANY_ADDRESS_CITY=
COMPANY_ADDRESS_STATE=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Produção: apenas butterfly.petlove.cloud
# Homolog: pode incluir localhost para testes locais
CORS_ORIGINS=https://butterfly.petlove.cloud
# CORS_ORIGINS=https://butterfly.petlove.cloud,http://localhost:3000
